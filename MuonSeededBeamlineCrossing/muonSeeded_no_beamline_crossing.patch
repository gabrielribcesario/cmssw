-}
+  // After its PCA to the beamline a track moves away from it (x*px + y*py > 0)
+  bool movesTowardsBeamline(const TempTrajectory& segment) {
+    const auto& measurements = segment.measurements();
+    for (auto it = measurements.rbegin(); it != measurements.rend(); --it) {
+      const auto& tsos = it->updatedState().isValid() ? it->updatedState() : it->forwardPredictedState();
+      if (!tsos.isValid())
+        continue;
+      const auto pos = tsos.globalPosition();
+      const auto pt = tsos.globalMomentum();
+      // Candidate has been extended through the beamline
+      if (pos.x() * pt.x() + pos.y() * pt.y() < 0.f)
+        return true;
+    }
+    return false;
+  }
+}  // namespace
 
